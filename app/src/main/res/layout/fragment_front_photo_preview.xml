<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/photo_camera_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#000000"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- 왼쪽 아이콘 -->
        <ImageView
            android:id="@+id/icon_fullratio"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/fullratio"
            android:contentDescription="Fullratio" />

        <!-- 중간 여백 -->
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 가운데 아이콘 -->
        <ImageView
            android:id="@+id/icon_nozoom"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/nozoom"
            android:contentDescription="Nozoom_Mode" />

        <!-- 중간 여백 -->
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/icon_zoom"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/zoom"
            android:contentDescription="Zoom_Mode" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 오른쪽 아이콘 -->
        <ImageView
            android:id="@+id/icon_setting"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/setting"
            app:tint="@android:color/white"
            android:contentDescription="Setting" />
    </LinearLayout>

    <!-- 카메라 프리뷰 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        app:implementationMode="performance"
        app:scaleType="fitCenter" />



    <!-- 전면 카메라는 줌 미지원이므로 줌 UI 제거 -->

    <!-- ⬇️ 모드 스위치 바 (사진/동영상) — 줌 슬라이더 바로 아래 -->
    <LinearLayout
        android:id="@+id/mode_switch_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="112dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 세 칸 슬롯(왼/중앙/오른쪽). 버튼을 이 슬롯들에 배치/이동 -->
        <FrameLayout
            android:id="@+id/slot_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/slot_center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- 초기: 사진 활성화 → 중앙에 사진 -->
            <TextView
                android:id="@+id/btn_mode_photo"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:text="사진"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/mode_chip_active" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/slot_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- 초기: 오른쪽에 동영상 -->
            <TextView
                android:id="@+id/btn_mode_video"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:text="동영상"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/mode_chip_inactive" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_button_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- 갤러리 버튼 -->
        <ImageButton
            android:id="@+id/gallery_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerCrop"
            android:clickable="true"
            android:focusable="true" />


        <ImageButton
            android:id="@+id/capture_button"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/ic_shutter"
            android:contentDescription="Capture Photo" />

        <ImageButton
            android:id="@+id/switch_camera_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/ic_camera_switch"
            app:tint="@android:color/white"
            android:contentDescription="Switch Camera" />
    </LinearLayout>

</FrameLayout>
