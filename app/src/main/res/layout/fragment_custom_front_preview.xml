<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 상단 바 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#000000"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/icon_fullratio"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/fullratio"
            android:contentDescription="Fullratio" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/icon_nozoom"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/nozoom"
            android:contentDescription="Nozoom_Mode" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/icon_zoom"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/zoom"
            android:contentDescription="Zoom_Mode" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/icon_setting"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/setting"
            app:tint="@android:color/white"
            android:contentDescription="Setting" />
    </LinearLayout>

    <!-- 카메라 프리뷰 -->
    <com.example.android.camera.utils.AutoFitSurfaceView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp" />

    <!-- ⬇️ 모드 스위치 바 (사진/동영상) -->
    <LinearLayout
        android:id="@+id/mode_switch_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="122dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 세 칸 슬롯(왼/중앙/오른쪽). 버튼을 이 슬롯들에 배치/이동 -->
        <FrameLayout
            android:id="@+id/slot_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- 초기: 사진 활성화 → 중앙에 사진 -->
            <TextView
                android:id="@+id/btn_mode_photo"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:text="사진"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@android:color/transparent" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/slot_center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- 초기: 오른쪽에 동영상 -->
            <TextView
                android:id="@+id/btn_mode_video"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:text="동영상"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@android:color/transparent" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/slot_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>

    <!-- 하단 버튼 그룹 -->
    <LinearLayout
        android:id="@+id/bottom_button_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="68dp"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageButton
            android:id="@+id/gallery_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="60dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerCrop"
            android:clickable="true"
            android:focusable="true" />

        <ImageButton
            android:id="@+id/capture_button"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ic_shutter"
            app:tint="@android:color/holo_red_dark"
            android:contentDescription="@string/capture" />

        <ImageButton
            android:id="@+id/switch_camera_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="60dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@drawable/ic_camera_switch"
            app:tint="@android:color/white"
            android:clickable="true"
            android:focusable="true" />
        
        <!-- Placeholder: 녹화 중 화면 전환 버튼이 사라져도 레이아웃 유지 -->
        <View
            android:id="@+id/switch_camera_placeholder"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="60dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 촬영 타이머 -->
    <!-- 녹화 타이머: 상단 중앙 -->
    <TextView
        android:id="@+id/capture_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="62dp"
        android:background="@drawable/bg_recording_timer"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="00:00:00"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 하단 네비게이션 바 -->
    <include
        layout="@layout/bottom_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="13dp" />
</FrameLayout>