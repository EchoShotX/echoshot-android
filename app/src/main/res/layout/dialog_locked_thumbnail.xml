<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@drawable/rounded_bg_dark">

    <!-- 1) 썸네일 -->
    <ImageView
        android:id="@+id/lockedThumbnail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="9:16"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 2) 크롭 모드(인물/와이드) -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleCropMode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/lockedThumbnail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCenterMode"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:text="인물중심 모드"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWideMode"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:text="와이드 모드"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- 3) 트래킹 성능(저사양/고사양) -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleTrackMode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/toggleCropMode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLowSpec"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:text="저사양 트래킹"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHighSpec"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:text="고사양 트래킹"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- 4) 시작 (단일 버튼) -->
    <Button
        android:id="@+id/startButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="시작"
        android:backgroundTint="#FF6200EE"
        android:textColor="@android:color/white"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/toggleTrackMode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 필요시 기존 btnMakeLog는 제거하거나 숨기세요 -->
    <!--
    <Button
        android:id="@+id/btnMakeLog"
        android:visibility="gone"
        ... />
    -->

</androidx.constraintlayout.widget.ConstraintLayout>
