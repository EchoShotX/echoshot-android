<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 상단 프로필 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="50dp"
        android:padding="24dp">

        <!-- 헤더 (알림 아이콘 및 설정) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <!-- 알림 벨 컨테이너 (왼쪽) -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <ImageView
                    android:id="@+id/notificationBell"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_notifications"
                    android:contentDescription="알림"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless" 
                    android:clickable="true"
                    android:focusable="true" />
                
                <!-- 알림 뱃지 (느낌표 배지) -->
                 <androidx.cardview.widget.CardView
                    android:id="@+id/notificationBadge"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="top|end"
                    app:cardCornerRadius="7dp"
                    app:cardBackgroundColor="#FF5252"
                    app:cardElevation="2dp"
                    android:visibility="gone">
                     
                     <TextView
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:text="!"
                         android:textColor="#FFFFFF"
                         android:textSize="10sp"
                         android:textStyle="bold"
                         android:layout_gravity="center" />
                 </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- 설정 아이콘 (오른쪽) -->
            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_settings"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="설정"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless" 
                android:clickable="true"
                android:focusable="true"/>
        </RelativeLayout>

        <!-- 프로필 이미지 -->
        <ImageView
            android:id="@+id/profileImage"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_person"
            android:contentDescription="프로필 이미지"
            android:background="@drawable/bg_nav_button_circle"
            android:padding="20dp"
            app:tint="@android:color/black"
            android:scaleType="fitCenter" />

        <!-- 사용자 이름 -->
        <TextView
            android:id="@+id/userName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="비회원"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 이메일 -->
        <TextView
            android:id="@+id/userEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- 크레딧 -->
        <TextView
            android:id="@+id/userCredit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#666666"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- 가입 날짜 -->
        <TextView
            android:id="@+id/userJoinedAt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="#999999"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 구글 로그인 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_marginTop="40dp">

        <!-- Google Sign-In Button (Google 브랜딩 가이드라인 준수) -->
        <LinearLayout
            android:id="@+id/btnGoogleLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_google_signin_button_pressed"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginHorizontal="24dp"
            android:elevation="1dp">

            <!-- Google G 로고 -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_google_logo"
                android:contentDescription="Google 로고"
                android:layout_marginEnd="12dp" />

            <!-- Sign in with Google 텍스트 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in with Google"
                android:textColor="#3c4043"
                android:textSize="14sp"
                android:textStyle="normal"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- 로그아웃 버튼 (로그인 시에만 표시) -->
        <LinearLayout
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_navigation_bar"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="로그아웃"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 빈 공간 (하단 바를 하단에 붙이기 위한 공간) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 하단 네비게이션 바 -->
    <include
        layout="@layout/bottom_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp" />

</LinearLayout>
