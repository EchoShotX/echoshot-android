<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#000000"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- 왼쪽 아이콘 -->
        <ImageView
            android:id="@+id/icon_fullratio"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/fullratio"
            android:contentDescription="Fullratio" />

        <!-- 중간 여백 -->
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 가운데 아이콘 -->
        <ImageView
            android:id="@+id/icon_nozoom"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/nozoom"
            android:contentDescription="Nozoom_Mode" />

        <!-- 중간 여백 -->
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/icon_zoom"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/zoom"
            android:contentDescription="Zoom_Mode" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 오른쪽 아이콘 -->
        <ImageView
            android:id="@+id/icon_setting"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/setting"
            app:tint="@android:color/white"
            android:contentDescription="Setting" />
    </LinearLayout>


    <!-- 카메라 프리뷰 (상단 바 아래에 배치) -->
    <com.example.android.camera.utils.AutoFitSurfaceView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp" />

    <!-- ② 그 위에 PoseOverlayView -->
    <com.echoshot.app.ui.PoseOverlayView
        android:id="@+id/poseOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp" />

    <FrameLayout
        android:id="@+id/overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        android:clipChildren="false"
        android:clipToPadding="false"/>

    <!-- 🎯 녹화 버튼: 가장 아래 -->
    <LinearLayout
        android:id="@+id/bottom_button_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="68dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- 🟩 갤러리 네모 버튼 -->
        <ImageButton
            android:id="@+id/gallery_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="60dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerCrop"
            android:clickable="true"
            android:focusable="true" />

        <!-- 🔴 촬영 버튼 -->
        <ImageButton
            android:id="@+id/capture_button"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ic_shutter"
            app:tint="@android:color/holo_red_dark"
            android:contentDescription="@string/capture" />

        <ImageButton
            android:id="@+id/auto_zoom_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="60dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@drawable/auto_zoom_btn"
            app:tint="@android:color/white"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 🎯 줌 슬라이더: 버튼 위 -->
    <!-- 줌 슬라이더 -->
    <SeekBar
        android:id="@+id/zoom_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center"
        android:layout_marginBottom="162dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:max="1000"
        android:progress="0"
        android:splitTrack="false"
        android:progressDrawable="@drawable/zoom_seekbar_track"
        android:thumb="@drawable/zoom_seekbar_thumb"
        android:thumbTintMode="src_in"
        android:thumbTint="@android:color/white" />

    <!-- ⬇️ 모드 스위치 바 (사진/동영상) — 줌 슬라이더 바로 아래 -->
    <LinearLayout
        android:id="@+id/mode_switch_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="122dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 세 칸 슬롯(왼/중앙/오른쪽). 버튼을 이 슬롯들에 배치/이동 -->
        <FrameLayout
            android:id="@+id/slot_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- 초기: 사진 활성화 → 중앙에 사진 -->
            <TextView
                android:id="@+id/btn_mode_photo"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:text="@string/photo"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@android:color/transparent" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/slot_center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- 초기: 오른쪽에 동영상 -->
            <TextView
                android:id="@+id/btn_mode_video"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:text="@string/video"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@android:color/transparent" />
        </FrameLayout>


        <FrameLayout
            android:id="@+id/slot_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

    </LinearLayout>

    <!-- 🎯 줌 텍스트: 슬라이더 위 -->
    <TextView
        android:id="@+id/zoom_level_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center"
        android:layout_marginBottom="187dp"
        android:text="1.0x"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:background="#80000000"
        android:padding="8dp"
        android:elevation="4dp" />

    <LinearLayout
        android:id="@+id/lens_selector"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="bottom|center"
        android:layout_marginBottom="187dp"
        android:background="@drawable/lens_selector_bg"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:elevation="4dp">

        <TextView
            android:id="@+id/btn_wide"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="W"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:background="@drawable/lens_chip_inactive"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/btn_tele"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="T"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:background="@drawable/lens_chip_inactive"/>
    </LinearLayout>

    <!-- 녹화 타이머: 상단 중앙 -->
    <TextView
        android:id="@+id/capture_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="62dp"
        android:background="@drawable/bg_recording_timer"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="00:00:00"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 하단 네비게이션 바 -->
    <include
        layout="@layout/bottom_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="13dp" />
</FrameLayout>
