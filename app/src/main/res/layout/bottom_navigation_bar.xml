<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_navigation_bar"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 하얀색 바 배경 (펼쳐지는 부분) -->
    <View
        android:id="@+id/nav_bar_background"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_navigation_bar" />

    <!-- 갤러리 버튼 (왼쪽) - 초기에는 가운데, 애니메이션으로 왼쪽 이동 -->
    <ImageView
        android:id="@+id/nav_gallery"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_photo_gallery"
        android:contentDescription="갤러리"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true"
        app:tint="@android:color/black"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- 카메라 버튼 (가운데, 항상 보임) -->
    <ImageView
        android:id="@+id/nav_camera"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_photo_camera"
        android:contentDescription="카메라"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true"
        app:tint="@android:color/black"
        android:background="@drawable/bg_camera_button_circle"
        android:scaleType="fitCenter"
        android:elevation="4dp" />

    <!-- 홈 버튼 (오른쪽) - 초기에는 가운데, 애니메이션으로 오른쪽 이동 -->
    <ImageView
        android:id="@+id/nav_home"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_home"
        android:contentDescription="홈"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true"
        app:tint="@android:color/black"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- 프로필 버튼 (홈 오른쪽) - 초기에는 가운데, 애니메이션으로 더 오른쪽 이동 -->
    <ImageView
        android:id="@+id/nav_profile"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_person"
        android:contentDescription="프로필"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true"
        app:tint="@android:color/black"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- 플레이스홀더 (숨김) -->
    <View
        android:id="@+id/nav_archive"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</FrameLayout>
