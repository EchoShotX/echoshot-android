<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_navigation_bar"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 하얀색 바 배경 (펼쳐지는 부분) -->
    <View
        android:id="@+id/nav_bar_background"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_navigation_bar" />

    <!-- 갤러리 버튼 (왼쪽) - 초기에는 가운데, 애니메이션으로 왼쪽 이동 -->
    <ImageView
        android:id="@+id/nav_gallery"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_photo_gallery"
        android:contentDescription="갤러리"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true"
        app:tint="@android:color/black"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- 카메라 버튼 (가운데, 항상 보임) -->
    <ImageView
        android:id="@+id/nav_camera"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_photo_camera"
        android:contentDescription="카메라"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true"
        app:tint="@android:color/black"
        android:background="@drawable/bg_camera_button_circle"
        android:scaleType="fitCenter"
        android:elevation="4dp" />

    <!-- 홈 버튼 (오른쪽) - 초기에는 가운데, 애니메이션으로 오른쪽 이동 -->
    <ImageView
        android:id="@+id/nav_home"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_home"
        android:contentDescription="홈"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true"
        app:tint="@android:color/black"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- 프로필 버튼 컨테이너 (홈 오른쪽) -->
    <FrameLayout
        android:id="@+id/nav_profile_container"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:visibility="gone">

        <ImageView
            android:id="@+id/nav_profile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_person"
            android:contentDescription="프로필"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true"
            app:tint="@android:color/black"
            android:scaleType="fitCenter" />

        <!-- 알림 뱃지 (빨간 점) -->
        <View
            android:id="@+id/nav_profile_badge"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_indicator_red_small"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 업로드 버튼 (왼쪽에서 두번째) - 초기에는 가운데, 애니메이션으로 왼쪽 이동 -->
    <ImageView
        android:id="@+id/nav_archive"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_note_add"
        android:contentDescription="직캠 편집"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true"
        app:tint="@android:color/black"
        android:scaleType="fitCenter"
        android:visibility="gone" />

</FrameLayout>
