<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_navigation_bar"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:orientation="horizontal"
    android:background="#000000"
    android:gravity="center_vertical"
    android:elevation="8dp">

    <!-- 1. 갤러리 -->
    <ImageView
        android:id="@+id/nav_gallery"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:src="@drawable/ic_photo_gallery"
        android:contentDescription="갤러리"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        app:tint="@android:color/white"
        android:background="?attr/selectableItemBackground"
        android:scaleType="fitCenter" />

    <!-- 2. 아카이브 (플레이스홀더 - 아이콘 없음) -->
    <View
        android:id="@+id/nav_archive"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:contentDescription="아카이브"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />

    <!-- 3. 카메라 -->
    <ImageView
        android:id="@+id/nav_camera"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:src="@drawable/ic_photo_camera"
        android:contentDescription="카메라"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        app:tint="@android:color/white"
        android:background="?attr/selectableItemBackground"
        android:scaleType="fitCenter" />

    <!-- 4. 프로필 (플레이스홀더 - 아이콘 없음) -->
    <View
        android:id="@+id/nav_profile"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:contentDescription="프로필"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />

    <!-- 5. 홈 -->
    <ImageView
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:src="@drawable/ic_home"
        android:contentDescription="홈"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        app:tint="@android:color/white"
        android:background="?attr/selectableItemBackground"
        android:scaleType="fitCenter" />
</LinearLayout>

