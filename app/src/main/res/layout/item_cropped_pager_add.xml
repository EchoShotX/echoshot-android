<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 카드 컨테이너: ViewPager2 요구 조건 충족 후 내부만 300dp로 -->
    <androidx.cardview.widget.CardView
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/rounded_bg_dark">

            <!-- 1) 썸네일 -->
            <ImageView
                android:id="@+id/thumb"
                android:layout_width="240dp"
                android:layout_height="135dp"
                android:scaleType="centerCrop"
                android:layout_gravity="center_horizontal"
                android:background="@android:color/black"/>

            <Space android:layout_width="0dp" android:layout_height="16dp"/>

            <!-- 2) 자동 구도 생성 버튼 -->
            <Button
                android:id="@+id/btnAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="자동 구도 생성"
                android:backgroundTint="#FF6200EE"
                android:textColor="@android:color/white"/>

            <Space android:layout_width="0dp" android:layout_height="8dp"/>

            <!-- 3) 인물 선택 구도 생성(SOT) 버튼 -->
            <Button
                android:id="@+id/btnSot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="인물 선택 구도 생성(SOT)"
                android:backgroundTint="#FF6200EE"
                android:textColor="@android:color/white"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
